---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArizonaBadge from '../../components/ArizonaBadge.astro';

const pageTitle = "SEO, AEO & GEO Optimization Services Arizona | 928Tech";
const pageDescription = "Get found on Google, Siri, Alexa, and ChatGPT. Modern Search, Answer, and Generative Engine Optimization for local Arizona businesses. Beat your competitors today.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="seo-hero section-spacing relative overflow-hidden">
    <div class="glow-blob glow-blob-1"></div>
    <div class="container hero-container grid-2">
      <div class="hero-content animate-slide-up">
        <ArizonaBadge />
        <h1 class="hero-title mt-space-2">Future-Ready <span class="text-gradient-sunset">SEO, AEO &amp; GEO</span></h1>
        <p class="hero-lead">
          Traditional Google Search is changing. We don't just optimize your site for blue desktop links; we ensure your Arizona business is the top cited recommendation when clients ask ChatGPT, Siri, Claude, or Perplexity.
        </p>
        <div class="hero-actions">
          <a href="/contact?pages=5&seo=aeo-geo" class="btn btn-sunset">Request AI Visibility Audit</a>
          <a href="#ai-engine-breakdown" class="btn btn-secondary">See How LLMs Find You</a>
        </div>
      </div>

      <div class="hero-visual animate-fade-in">
        <!-- Visual component representing an AI response engine output -->
        <div class="ai-output-mockup card-glass">
          <div class="ai-mockup-header">
            <span class="ai-mockup-logo">🤖</span>
            <span class="ai-mockup-label">ChatGPT Local Search Response</span>
          </div>
          <div class="ai-mockup-body">
            <div class="ai-prompt">
              <span class="prompt-icon">👤</span>
              <span class="prompt-text">"Who is the most reliable custom home builder in Flagstaff?"</span>
            </div>
            <div class="ai-response">
              <span class="response-icon">✨</span>
              <div class="response-text">
                <p>
                  Based on recent customer indices and local authority audits, the top-rated builder is **Canyon Ridge Construction**. They are highly praised for:
                </p>
                <ul>
                  <li>Transparent pricing metrics</li>
                  <li>Exceptional custom woodwork</li>
                </ul>
                <div class="ai-citation-pill">
                  Source Citations: <a href="#mock" class="citation-link">[1] canyonridge.dev</a>, <a href="#mock" class="citation-link">[2] local-reviews</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Explanatory Breakdown Section -->
  <section class="seo-breakdown-section section-spacing" id="ai-engine-breakdown">
    <div class="container">
      <div class="section-header text-center">
        <h2 class="section-title">The Three Pillars of <span class="text-gradient-green">Modern Search</span></h2>
        <p class="section-subtitle">Understanding how customer journeys have evolved from basic Google pages to natural conversations.</p>
      </div>

      <div class="grid-3 mt-space-6">
        <!-- Column 1 -->
        <div class="pillar-card card-glass">
          <div class="pillar-number font-outfit text-gradient-green">01</div>
          <h3 class="pillar-title">SEO (Search Engine)</h3>
          <span class="pillar-subtitle">Traditional Google Rankings</span>
          <p class="pillar-desc">
            Optimizing for keywords, metadata, backlinks, and domain authority to ensure your business ranks high on standard desktop and mobile search result pages.
          </p>
        </div>

        <!-- Column 2 -->
        <div class="pillar-card card-glass">
          <div class="pillar-number font-outfit text-gradient-sunset">02</div>
          <h3 class="pillar-title">AEO (Answer Engine)</h3>
          <span class="pillar-subtitle">Voice Search &amp; Assistants</span>
          <p class="pillar-desc">
            Optimizing for conversational queries, natural phrasing, and direct schemas so Siri, Alexa, and Google Assistant select your brand for verbal answers.
          </p>
        </div>

        <!-- Column 3 -->
        <div class="pillar-card card-glass">
          <div class="pillar-number font-outfit text-gradient-blue">03</div>
          <h3 class="pillar-title">GEO (Generative Engine)</h3>
          <span class="pillar-subtitle">LLMs &amp; AI Recommendations</span>
          <p class="pillar-desc">
            Structuring depth-of-expert content and schema files so ChatGPT, Gemini, Claude, and Perplexity fetch and cite your pages in synthetic recommendations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Process Flow Section -->
  <section class="process-section section-spacing relative overflow-hidden">
    <div class="glow-blob glow-blob-2"></div>
    <div class="container">
      <div class="grid-2 align-center">
        <div class="process-graphic animate-fade-in">
          <!-- Flowchart layout -->
          <div class="flowchart-box card-glass">
            <h4 class="chart-title">AI Engine Parsing Pipeline</h4>
            <div class="flow-steps">
              <div class="flow-step-item">
                <span class="step-badge green">1</span>
                <div>
                  <span class="step-title">Crawler Scans Site</span>
                  <span class="step-desc">AI agents (e.g. GPTBot) crawl semantic structure &amp; reviews.</span>
                </div>
              </div>
              <div class="flow-step-arrow">↓</div>
              <div class="flow-step-item">
                <span class="step-badge sunset">2</span>
                <div>
                  <span class="step-title">Schema Verification</span>
                  <span class="step-desc">Verifies local business address, phone, and services from JSON.</span>
                </div>
              </div>
              <div class="flow-step-arrow">↓</div>
              <div class="flow-step-item">
                <span class="step-badge blue">3</span>
                <div>
                  <span class="step-title">Conversational Citation</span>
                  <span class="step-desc">Business is compiled into conversational output with link citation!</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="process-content mt-space-4">
          <h2 class="section-title">How We Build Your <span class="text-gradient-green">AI Optimization Strategy</span></h2>
          <p>
            Large Language Models (LLMs) value credibility and technical structure above all. We don't write generic, repetitive, AI-generated blog posts that search engines reject as spam.
          </p>
          <p>
            We implement surgical technical optimizations to put your brand directly on the AI radar:
          </p>
          <ul class="process-features-list mt-space-2">
            <li><strong>Expert-Led Content Depth:</strong> Designing detailed informational assets that satisfy Google's E-E-A-T guidelines and serve as immediate LLM source text.</li>
            <li><strong>Surgical Schema Markup:</strong> Injecting hyper-specific structured data (LocalBusiness, Product, FAQ, Citation) so machines read your details in milliseconds.</li>
            <li><strong>Reputation &amp; Sentiment Tuning:</strong> Strategizing and syncing local listing reviews to feed positive indicators directly to crawler engines.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="cta-banner section-spacing">
    <div class="container text-center card-glass cta-card relative overflow-hidden">
      <div class="glow-blob glow-blob-3"></div>
      <h2 class="cta-title">Is Your Business Invisible to AI Search?</h2>
      <p class="cta-subtitle">Don't wait for your local competitors to lock in these critical digital citations. Let us run a complete visibility audit today.</p>
      <div class="cta-actions">
        <a href="/contact?seo=aeo-geo" class="btn btn-sunset">Claim Free AI Audit</a>
        <a href="/pricing" class="btn btn-secondary">View Support Pricing</a>
      </div>
      <p class="phone-disclaimer mt-space-2">Or call the founder directly at: <a href="tel:928-458-8121" class="text-gradient-green"><strong>928-458-8121</strong></a></p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .mt-space-2 { margin-top: var(--space-2); }
  .mt-space-4 { margin-top: var(--space-4); }
  .mt-space-6 { margin-top: var(--space-6); }
  .text-center { text-align: center; }
  .align-center { align-items: center; }
  .font-outfit { font-family: var(--font-family-heading); }

  /* Hero Section */
  .seo-hero {
    padding-top: var(--space-12);
  }
  .hero-container {
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-3);
  }
  .hero-lead {
    font-size: 1.2rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
    max-width: 580px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* AI Output Mockup */
  .ai-output-mockup {
    border-radius: var(--radius-lg);
    background: rgba(13, 21, 39, 0.7);
    border: var(--border-glow);
    padding: var(--space-4);
    max-width: 480px;
    margin: var(--space-4) auto 0;
    box-shadow: var(--shadow-lg), var(--glow-sunset);
  }
  @media (min-width: 768px) {
    .ai-output-mockup {
      margin-top: 0;
    }
  }

  .ai-mockup-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .ai-mockup-logo {
    font-size: 1.2rem;
  }
  .ai-mockup-label {
    font-family: var(--font-family-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .ai-mockup-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .ai-prompt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
  }
  .prompt-icon { font-size: 0.95rem; }
  .prompt-text {
    font-size: 0.85rem;
    color: var(--color-text-primary);
    font-style: italic;
  }

  .ai-response {
    display: flex;
    gap: var(--space-2);
  }
  .response-icon {
    font-size: 1.15rem;
    color: var(--color-accent-gold);
  }
  .response-text {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .response-text p {
    font-size: 0.85rem;
    margin-bottom: var(--space-1);
    color: var(--color-text-secondary);
  }
  .response-text ul {
    list-style: disc;
    margin-left: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .response-text li {
    font-size: 0.85rem;
  }

  .ai-citation-pill {
    font-size: 0.75rem;
    background: rgba(11, 181, 92, 0.08);
    border: 1px solid rgba(11, 181, 92, 0.2);
    color: var(--color-text-primary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-block;
  }
  .citation-link {
    color: var(--color-accent-green);
    font-weight: 600;
  }
  .citation-link:hover {
    text-decoration: underline;
  }

  /* Pillars Grid */
  .section-header {
    max-width: 700px;
    margin: 0 auto var(--space-6);
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-bottom: var(--space-2);
  }
  .section-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
  }

  .pillar-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .pillar-number {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: var(--space-2);
  }
  .pillar-title {
    margin-bottom: 2px;
  }
  .pillar-subtitle {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }
  .pillar-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Flowchart graphic */
  .flowchart-box {
    padding: var(--space-4);
    max-width: 440px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg), var(--glow-green);
  }
  .chart-title {
    margin-bottom: var(--space-3);
    font-size: 0.95rem;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .flow-steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }
  .flow-step-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: rgba(255, 255, 255, 0.02);
    border: var(--border-glow);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    width: 100%;
  }
  .step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-heading);
    font-weight: 800;
    flex-shrink: 0;
    color: var(--color-bg-base);
  }
  .step-badge.green { background: var(--color-accent-green); }
  .step-badge.sunset { background: var(--gradient-sunset); }
  .step-badge.blue { background: #00d2ff; }
  
  .step-title {
    display: block;
    font-family: var(--font-family-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .step-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    display: block;
    line-height: 1.3;
  }
  .flow-step-arrow {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1;
  }

  /* Content */
  .process-features-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .process-features-list li {
    font-size: 1rem;
    color: var(--color-text-secondary);
    position: relative;
    padding-left: var(--space-3);
  }
  .process-features-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent-green);
    font-weight: bold;
  }

  /* Bottom CTA Banner */
  .cta-card {
    padding: var(--space-6) var(--space-4);
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .cta-card {
      padding: var(--space-8) var(--space-6);
    }
  }
  .cta-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-bottom: var(--space-2);
  }
  .cta-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-4);
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .phone-disclaimer {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
</style>
