---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArizonaBadge from '../components/ArizonaBadge.astro';

const pageTitle = "Page Not Found | 928Tech";
const pageDescription = "The page you are looking for has wandered away into the Arizona desert like a tumbleweed. Return home or request a direct strategy blueprint.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header slot="header" />

  <section class="error-section section-spacing relative overflow-hidden">
    <div class="glow-blob glow-blob-1"></div>
    <div class="container text-center animate-slide-up">
      <ArizonaBadge size="small" />
      
      <div class="error-badge card-glass mt-space-3">404</div>
      <h1 class="error-title">Tumbleweed Alert: <span class="text-gradient-sunset">Page Not Found</span></h1>
      <p class="error-lead">
        The page you are looking for has wandered off into the high desert. Let's get you back on track before nightfall.
      </p>

      <div class="error-actions mt-space-4">
        <a href="/" class="btn btn-sunset">Return Home Safely</a>
        <a href="/pricing" class="btn btn-secondary">Calculate Build Quote</a>
        <a href="/contact" class="btn btn-secondary">Direct Strategist desk</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .mt-space-3 { margin-top: var(--space-3); }
  .mt-space-4 { margin-top: var(--space-4); }
  .text-center { text-align: center; }

  .error-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-16);
  }

  .error-badge {
    display: inline-block;
    font-family: var(--font-family-heading);
    font-size: 3rem;
    font-weight: 800;
    color: var(--color-accent-green);
    background: rgba(11, 181, 92, 0.05);
    border-color: rgba(11, 181, 92, 0.2);
    padding: 0.5rem 1.5rem;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-2);
    letter-spacing: -2px;
  }

  .error-title {
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    margin-bottom: var(--space-2);
  }

  .error-lead {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
